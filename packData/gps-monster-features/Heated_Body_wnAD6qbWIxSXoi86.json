        "type": "script",
        "scope": "global",
        "command": "if(args[0].macroPass === \"isHit\") {\n\tif(workflow.activity.actionType === \"mwak\" || workflow.activity.actionType === \"msak\")\n\t{\n\t\tlet measuredDistance = MidiQOL.computeDistance(token,workflow.token, {wallsBlock: true, includeCover: true});\n\t\tlet range = game.gps.convertFromFeet({range: 5});\n\t\tif (measuredDistance < 0 || measuredDistance > range) return;\n\t\tconst damageDice = \"2d6\"; // Change damage dice here\n\t\tconst damageType = \"fire\"; // Change damage type here\n\n\t\tlet damageRoll = await new CONFIG.Dice.DamageRoll(`${damageDice}`, {}, {type: damageType, properties: [\"mgc\"]}).evaluate();\n\t\tawait MidiQOL.displayDSNForRoll(damageRoll, 'damageRoll');\n\n\t\tconst itemData = {\n\t\t\tflags: {autoanimations: {isEnabled: false, version: 5}},\n\t\t\tname: \"Heated Body - Damage (Fire)\",\n\t\t\ttype: \"feat\",\n\t\t\timg: macroItem.img\n      \t}\n\n\t\tnew MidiQOL.DamageOnlyWorkflow(actor, token, damageRoll.total, damageType, workflow.token ? [workflow.token] : [], damageRoll, {itemData: itemData, flavor: \"Heated Body - Damage (Fire)\"});\n\t}\n}",
