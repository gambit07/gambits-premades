        "command": "if(args[0].macroPass === \"isDamaged\") {\n    let coldDamage = workflow.damageDetail.some(roll => roll.type === \"cold\");\n    if(!coldDamage) return;\n    let gmUser = game.gps.getPrimaryGM();\n    \n    let effectData = [{\n      \"origin\": macroItem.uuid,\n      \"duration\": { expiry: \"targetEnd\", value: 12, units: \"seconds\" },\n      \"disabled\": false,\n      \"name\": \"Frozen\",\n      \"img\": macroItem.img,\n      system: { changes: [\n        ...game.gps.movementSpeedChanges(\"-20\", 20)\n      ] },\n      \"transfer\": false,\n      \"flags\": {\n        \"dae\": {\n          \"specialDuration\": []\n        }\n      }\n    }];\n\n    await MidiQOL.socket().executeAsUser(\"createEffects\", gmUser, { actorUuid: actor.uuid, effects: effectData });\n}",
