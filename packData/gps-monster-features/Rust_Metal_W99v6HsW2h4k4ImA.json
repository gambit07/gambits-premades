        "type": "script",
        "scope": "global",
        "command": "const weapon = workflow.item;\nif(weapon.type !== \"weapon\" || workflow.activity?.actionType !== \"mwak\" || workflow.activity?.midiProperties?.magicDamage || weapon.system.properties.has(\"mgc\") || weapon.system.magicalBonus) return;\nconst material = String(weapon.system.material?.type ?? \"\").toLowerCase();\nconst base = weapon.system.type?.baseItem ?? weapon.system.baseItem;\nconst metalWeapons = new Set([\"dagger\", \"handaxe\", \"javelin\", \"mace\", \"sickle\", \"spear\", \"battleaxe\", \"flail\", \"glaive\", \"greataxe\", \"greatsword\", \"halberd\", \"lance\", \"longsword\", \"maul\", \"morningstar\", \"pike\", \"rapier\", \"scimitar\", \"shortsword\", \"trident\", \"warpick\", \"warhammer\"]);\nif(material ? ![\"iron\", \"steel\", \"silver\", \"adamantine\", \"mithral\"].includes(material) : !metalWeapons.has(base)) return;\nconst existing = weapon.effects.find(effect => effect.flags[\"gambits-premades\"]?.rustMetal);\nconst penalty = Number(existing?.getFlag(\"gambits-premades\", \"rustMetal\") ?? 0) - 1;\nif(penalty <= -5) {\n    await weapon.delete();\n    return;\n}\nconst data = {name: \"Rust Metal\", type: \"enchantment\", transfer: true, origin: macroItem.uuid, system: {magical: false, changes: [{key: \"system.damage.bonus\", type: \"add\", value: String(penalty), priority: 20}]}, flags: {\"gambits-premades\": {rustMetal: penalty}}};\nif(existing) await existing.update(data);\nelse await weapon.createEmbeddedDocuments(\"ActiveEffect\", [data]);\n",
