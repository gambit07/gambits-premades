        "scope": "global",
        "command": "if(args[0] === \"each\") {\n    let effectOriginActor = await fromUuid(args[1]);\n    let effectOriginToken = await MidiQOL.tokenForActor(effectOriginActor.uuid);\n    if(effectOriginActor.uuid === actor.uuid) return;\n    let damageRoll = await new CONFIG.Dice.DamageRoll(`2d4`, {}, {type: \"cold\", properties: [\"mgc\"]}).evaluate();\n    await MidiQOL.displayDSNForRoll(damageRoll, 'damageRoll');\n\n    const itemData = {\n        flags: {autoanimations: {isEnabled: false, version: 5}},\n        name: \"Cold Aura - Damage (Cold)\",\n        type: \"feat\",\n        img: item.img,\n    }\n\n    await new MidiQOL.DamageOnlyWorkflow(effectOriginActor, effectOriginToken, damageRoll.total, \"cold\", token ? [token] : [], damageRoll, {itemData: itemData, flavor: \"Cold Aura - Damage (Cold)\"});\n}",
