    "dae": {
      "macro": {
        "name": "Web Strand",
        "img": "icons/commodities/materials/material-webbing.webp",
        "type": "script",
        "scope": "global",
        "command": "if(args[0].macroPass === \"postActiveEffects\") {\n    let target = workflow.hitTargets.first();\n    if(!target) return;\n\n    let webItem = await target.actor.appliedEffects.find(e => DAE.effectMatchesSource(e, macroItem?.uuid ?? item.uuid) && e.name === (macroItem?.name ?? item.name));\n    if(!webItem) return;\n    await webItem.setFlag(\"gambits-premades\", \"webHP\", 20);\n    \n    if(game.gps.getCprConfig({itemUuid: macroItem.uuid}).animEnabled) {\n        new Sequence()\n        .effect()\n            .file(\"jb2a.energy_beam.normal.dark_greenpurple.03\")\n            .persist()\n            .name(`${target.id}_webStrand`)\n            .fadeIn(500)\n            .fadeOut(500)\n            .attachTo(token, {offset: { x: -125, y: 35 }})\n            .filter(\"ColorMatrix\", { hue: 0, saturate: -1 })\n            .stretchTo(target,{ attachTo: true })\n        .play()\n    }\n\n    if(game.gps.getCprConfig({itemUuid: macroItem.uuid}).animEnabled) {\n        new Sequence()\n            .effect()\n            .file(\"jb2a.shield_themed.below.eldritch_web.02.dark_green\")\n            .belowTokens()\n            .persist()\n            .name(`${target.id}_web`)\n            .fadeIn(500)\n            .fadeOut(500)\n            .scaleToObject(1.5)\n            .attachTo(target)\n            .filter(\"ColorMatrix\", { hue: 0, saturate: -1 })\n        .play()\n    }\n}\n\nif(args[0] === \"off\") {\n    Sequencer.EffectManager.endEffects({ name: `${token.id}_webStrand` });\n    Sequencer.EffectManager.endEffects({ name: `${token.id}_web` });\n}\n\nif(args[0].macroPass === \"isAttacked\") {\n    let attacker = workflow.token;\n    if(token.document.disposition !== attacker.document.disposition) return;\n\n    const webItem = token.actor.appliedEffects.find(effect => DAE.effectMatchesSource(effect, macroItem.uuid) && effect.name === macroItem.name);\n    if(!webItem || workflow.isFumble || (!workflow.isCritical && workflow.attackTotal < 12)) return;\n    const rolls = await workflow.activity.rollDamage({isCritical: workflow.isCritical}, {configure: true}, {create: false});\n    if(!rolls?.length) return;\n    const immune = new Set([\"bludgeoning\", \"poison\", \"psychic\"]);\n    const damageTotal = rolls.reduce((sum, roll) => sum + (immune.has(roll.options.type) ? 0 : roll.total * (roll.options.type === \"fire\" ? 2 : 1)), 0);\n    const damageRoll = rolls[0];\n    const webHP = webItem.getFlag(\"gambits-premades\", \"webHP\") ?? 20;\n    let hpRemaining = webHP - damageTotal;\n    let chatContent;\n\n    if (hpRemaining > 0) {\n        await webItem.setFlag(\"gambits-premades\", \"webHP\", hpRemaining);\n        chatContent = `<span style='text-wrap: wrap;'>${attacker.document.name} hit the web strands surrounding you dealing ${damageTotal} points of damage. <img src=\"${attacker.actor.img}\" width=\"30\" height=\"30\" style=\"border:0px\"></span>`;\n    } else {\n        await webItem.delete();\n        chatContent = `<span style='text-wrap: wrap;'>${attacker.document.name} hit the web strands surrounding you dealing ${damageTotal} points of damage and destroyed the web. <img src=\"${attacker.actor.img}\" width=\"30\" height=\"30\" style=\"border:0px\"></span>`;\n    }\n\n    await game.gps.replaceChatCard({actorUuid: token.actor.uuid, itemUuid: item.uuid, chatContent: chatContent, rollData: damageRoll});\n\n    workflow.aborted = true;\n}",
        "author": "roRDywD19pu2VxlC",
        "ownership": {
          "default": 3
        },
