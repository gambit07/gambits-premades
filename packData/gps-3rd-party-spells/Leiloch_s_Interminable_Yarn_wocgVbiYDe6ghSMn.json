    "dae": {
      "macro": {
        "name": "Leiloch’s Interminable Yarn",
        "img": "icons/skills/trades/music-singing-voice-blue.webp",
        "type": "script",
        "scope": "global",
        "command": "if(args[0].macroPass === \"postActiveEffects\") {\n    let itemData = game.gps.disableBlfxAutoRecognition({\n        \"name\": \"Leiloch’s Interminable Yarn - Pull Away\",\n        \"type\": \"feat\",\n        \"img\": macroItem.img,\n        \"system\": {\n            activities: {\n                gpsSynthetic0001: {\n                    type: \"save\",\n                    midiProperties: { magicEffect: true },\n                    activation: { type: \"special\" },\n                    consumption: { spellSlot: false, targets: [] },\n                    target: { affects: { type: \"self\" } },\n                    save: { ability: [\"wis\"], dc: { calculation: \"\", formula: String(actor.system.attributes.spell.dc) } },\n                    effects: [{ _id: \"gpsYarnSleep0001\", onSave: false }]\n                }\n            }\n        },\n        \"effects\": [\n            {\n                _id: \"gpsYarnSleep0001\",\n                img: macroItem.img,\n                \"duration\": { value: 60, units: \"seconds\" },\n                \"disabled\": false,\n                \"name\": \"Leiloch’s Interminable Yarn - Unconscious\",\n                system: { changes: [\n                    {\n                        \"key\": \"macro.StatusEffect\",\n                        type: \"custom\",\n                        \"value\": \"unconscious\",\n                        \"priority\": 20\n                    }\n                ] },\n                \"transfer\": false\n            }\n        ],\n        \"flags\": {\n            autoanimations: {isEnabled: false, version: 5},\n            \"midi-qol\": {\n                \"onUseMacroName\": \"[postActiveEffects]ItemMacro\"\n            },\n            \"dae\": {\n                \"macro\": {\n                    \"name\": \"Leiloch’s Interminable Yarn - Pull Away\",\n                    \"img\": macroItem.img,\n                    \"type\": \"script\",\n                    \"scope\": \"global\",\n                    \"command\": \"const source = await fromUuid(macroItem.getFlag(\\\"dnd5e\\\", \\\"dependentOn\\\")); await source?.delete(); if(actor.items.has(macroItem.id)) await macroItem.delete();\"\n                }\n            }\n        }\n    })\n\n    for (let target of workflow.targets) {\n        const source = target.actor.appliedEffects.find(effect => DAE.effectMatchesSource(effect, macroItem.uuid) && effect.name === macroItem.name);\n        if(!source) continue;\n        itemData.flags.dnd5e = {dependentOn: source.uuid};\n        await target.actor.createEmbeddedDocuments(\"Item\", [itemData]);\n    }\n}\n\nif(args[0] === \"off\") {\n    const sourceUuid = args.at(-1)?.effectUuid ?? `${actor.uuid}.ActiveEffect.${args.at(-1)?.effectId}`;\n    const helpers = actor.items.filter(helper => helper.getFlag(\"dnd5e\", \"dependentOn\") === sourceUuid);\n    if(helpers.length) await actor.deleteEmbeddedDocuments(\"Item\", helpers.map(helper => helper.id));\n}\n",
