  "flags": {
    "core": {},
    "dae": {
      "macro": {
        "name": "Electric Eels",
        "img": "icons/magic/lightning/barrier-wall-shield-gray.webp",
        "type": "script",
        "scope": "global",
        "command": "const effectUuid = args.at(-1)?.effectUuid ?? (args.at(-1)?.effectId ? `${actor.uuid}.ActiveEffect.${args.at(-1).effectId}` : undefined);\nif(args[0]?.macroPass === \"postActiveEffects\") {\n    if(!game.modules.get(\"portal-lib\")?.active) return ui.notifications.error(\"Electric Eels requires Portal.\");\n    const source = actor.appliedEffects.find(effect => DAE.effectMatchesSource(effect, item.uuid) && effect.name === item.name);\n    const template = game.actors.getName(\"Electric Eel\");\n    if(!source || !template) return;\n    const ability = actor.system.attributes.spellcasting;\n    const updateData = {\n        token: {actorLink: false, flags: {\"gambits-premades\": {electricEelsSource: source.uuid}}},\n        actor: {system: {attributes: {spellcasting: ability}, abilities: {[ability]: {value: actor.system.abilities[ability].value}}}}\n    };\n    for(let index = 0; index < 2; index++) {\n        const summoned = await new Portal().color(\"#ff0000\").origin(token).addCreature(template.uuid, {count: 1, updateData: foundry.utils.deepClone(updateData)}).range(game.gps.convertFromFeet({range: 60})).spawn();\n        if(!summoned?.length) break;\n        const uuids = source.getFlag(\"gambits-premades\", \"electricEelsTokens\") ?? [];\n        await source.setFlag(\"gambits-premades\", \"electricEelsTokens\", [...uuids, ...summoned.map(token => token.uuid)]);\n        if(game.gps.getCprConfig({itemUuid: item.uuid}).animEnabled) new Sequence().effect().file(\"jb2a.lightning_bolt.wide.green\").atLocation(token).stretchTo(summoned[0].object).play();\n    }\n}\nif(args[0] === \"off\" && effectUuid) {\n    for(const scene of game.scenes) {\n        const ids = scene.tokens.filter(token => token.getFlag(\"gambits-premades\", \"electricEelsSource\") === effectUuid).map(token => token.id);\n        if(ids.length) await scene.deleteEmbeddedDocuments(\"Token\", ids);\n    }\n}\nif(args[0] === \"on\" && actor.name === \"Electric Eel\" && effectUuid) {\n    const actorUuid = args.at(-1)?.efData?.flags?.dae?.actor ?? args[1]?.efData?.flags?.dae?.actor;\n    if(!actorUuid) return;\n    const sourceActor = await fromUuid(actorUuid);\n    if(!sourceActor) return;\n    const key = sourceActor.system.traits.dr.value.has(\"lightning\") ? \"system.traits.di.value\" : \"system.traits.dr.value\";\n    await MidiQOL.socket().executeAsGM(\"createEffects\", {actorUuid: sourceActor.uuid, effects: [{name: item.name, img: item.img, origin: item.uuid, flags: {dnd5e: {dependentOn: effectUuid}}, system: {changes: [{key, type: \"add\", value: \"lightning\", priority: 20}]}}]});\n}\n",
        "author": "roRDywD19pu2VxlC",
        "ownership": {
          "default": 3
        },
