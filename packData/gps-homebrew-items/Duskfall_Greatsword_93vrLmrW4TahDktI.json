    "dae": {
      "macro": {
        "name": "Duskfall Greatsword",
        "img": "icons/weapons/swords/greatsword-crossguard-embossed-gold.webp",
        "type": "script",
        "scope": "global",
        "command": "if(args[0].macroPass === \"isAttacked\") {\n    if(token.actor.items.filter(i => i.name.toLowerCase().includes('shield') && i.system.equipped === true).length > 0) return; // Origin token is using a shield\n    if(workflow.advantage === true) {\n      let effectData = [\n      {\n        \"name\": \"Duskfall Greatsword - Guardless AC\",\n        img: macroItem.img,\n        \"origin\": macroItem.uuid,\n        \"disabled\": false,\n        system: { changes: [\n          {\n            \"key\": \"system.attributes.ac.value\",\n            type: \"add\",\n            \"value\": 2,\n            \"priority\": 20\n          }\n        ] },\n        \"flags\": {\n          \"dae\": {\n            \"specialDuration\": [\n              \"isAttacked\"\n            ]\n          }\n        },\n        \"transfer\": false\n      }\n    ]\n    await MidiQOL.socket().executeAsGM(\"createEffects\", { actorUuid: actor.uuid, effects: effectData });\n  }\n}",
        "author": "roRDywD19pu2VxlC",
